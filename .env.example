# Copia este archivo como ".env" y reemplaza los placeholders por los
# valores reales. El ".env" real NUNCA se sube a git (ver .gitignore).
# En Render, estas mismas variables se configuran en Settings -> Environment
# (no se usa este archivo ahí, load_dotenv() simplemente no encuentra nada
# que cargar y el sistema sigue leyendo las variables de entorno reales).
#
# Todas se leen en un solo lugar: backend/config.py

# ── Portal y módulos que consultan Supabase ───────────────────────────
# (SAE, FRV, Vista Inmuebles, Estadísticas, Permisos)
SECRET_KEY=TU_VALOR_AQUI
SUPABASE_URL=TU_VALOR_AQUI
SUPABASE_ANON_KEY=TU_VALOR_AQUI
SUPABASE_SERVICE_ROLE_KEY=TU_VALOR_AQUI
PORT=5000

# ── API de integración externa (/api/integracion/inmuebles) ───────────
# Clave fija con la que un sistema externo (no una persona) consulta
# inmuebles por FMI, usando el header X-API-Key. Si se deja vacía, ese
# endpoint responde 503 y queda deshabilitado.
INTEGRACION_API_KEY=TU_VALOR_AQUI

# ── Módulo Documentos: base de datos propia (Neon) ──────────────────────
# Guarda los casos, documentos subidos/generados (como bytea) y las
# correcciones manuales. Sacar del dashboard de Neon -> Connect.
DATABASE_URL=TU_VALOR_AQUI

# ── Módulo Documentos: base de negocio existente (solo lectura) ────────
# La usan Certificado DD, Acta de Subasta y Declaración Juramentada para
# leer subastas y participantes. Este sistema NUNCA escribe en esta base.
AZURE_DATABASE_URL=TU_VALOR_AQUI

# ── scripts/actualizar_dashboard.py (las usa la GitHub Action) ─────────
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY de arriba también le sirven.
INTRANET_DB_HOST=TU_VALOR_AQUI
INTRANET_DB_PORT=5432
INTRANET_DB_NAME=intranet
INTRANET_DB_USER=TU_VALOR_AQUI
INTRANET_DB_PASSWORD=TU_VALOR_AQUI
